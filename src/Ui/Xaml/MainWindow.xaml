<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="CL-Wallpaper" Width="1220" Height="770" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBg}"
        FontFamily="{DynamicResource UiFont}" FontSize="{DynamicResource UiFontSize}"
        Foreground="{DynamicResource Fg}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <ContentControl x:Name="WinFrame" Style="{DynamicResource WindowFrame}" Focusable="False">
  <Grid x:Name="Root">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="240"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- ======================= OLD SCHOOL TITLE BAR ======================= -->
    <Border x:Name="RetroTitle" Grid.ColumnSpan="2" Height="20" Margin="0,0,0,2" Visibility="Collapsed" Background="{DynamicResource TitleActive}">
      <DockPanel Margin="3,0,2,0">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Button x:Name="RBtnMin" Style="{DynamicResource TitleBtn}" ToolTip="Réduire">
            <Rectangle Width="6" Height="2" Fill="{DynamicResource Fg}" VerticalAlignment="Bottom" Margin="0,5,1,0"/>
          </Button>
          <Button x:Name="RBtnMax" Style="{DynamicResource TitleBtn}" ToolTip="Agrandir">
            <Grid>
              <Border x:Name="RMaxGlyph" Width="9" Height="8" BorderBrush="{DynamicResource Fg}" BorderThickness="1,2,1,1"/>
              <Grid x:Name="RRestoreGlyph" Width="8" Height="8" Visibility="Collapsed">
                <Border Width="6" Height="5" BorderBrush="{DynamicResource Fg}" BorderThickness="1,2,1,1" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                <Border Width="6" Height="5" BorderBrush="{DynamicResource Fg}" BorderThickness="1,2,1,1" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="{DynamicResource Face}"/>
              </Grid>
            </Grid>
          </Button>
          <Button x:Name="RBtnClose" Style="{DynamicResource TitleBtn}" Margin="2,0,0,0" ToolTip="Fermer">
            <Path Data="M0,0 L7,6 M7,0 L0,6" Stroke="{DynamicResource Fg}" StrokeThickness="1.6"/>
          </Button>
        </StackPanel>
        <Image x:Name="RetroIcon" Width="16" Height="16" Margin="0,0,4,0" VerticalAlignment="Center"/>
        <TextBlock x:Name="RetroTitleText" Text="CL-Wallpaper" Foreground="{DynamicResource TitleFg}" FontWeight="Bold" VerticalAlignment="Center"/>
      </DockPanel>
    </Border>

    <!-- ======================= SIDEBAR ======================= -->
    <Border x:Name="Sidebar" Grid.Row="1" Background="{DynamicResource SidebarBg}">
      <DockPanel>
        <Grid x:Name="SidebarTop" DockPanel.Dock="Top" Height="52">
          <StackPanel x:Name="Lights" Orientation="Horizontal" Margin="20,0,0,0" HorizontalAlignment="Left"
                      Background="Transparent" shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Button x:Name="BtnClose" Style="{DynamicResource Light}" Background="#FF5F57" Content="&#xE711;" ToolTip="Fermer"/>
            <Button x:Name="BtnMin" Style="{DynamicResource Light}" Background="#FEBC2E" Content="&#xE738;" ToolTip="Réduire"/>
            <Button x:Name="BtnMax" Style="{DynamicResource Light}" Background="#28C840" Content="&#xE740;" ToolTip="Agrandir"/>
          </StackPanel>
          <StackPanel x:Name="Brand" Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False">
            <Image x:Name="BrandIcon" Width="22" Height="22" VerticalAlignment="Center"/>
            <TextBlock Text="CL-Wallpaper" FontFamily="{DynamicResource DisplayFont}" FontSize="18" Margin="9,0,0,2" VerticalAlignment="Center"/>
          </StackPanel>
        </Grid>

        <StackPanel DockPanel.Dock="Bottom" Margin="12,6,12,12">
          <ContentControl x:Name="NowCard" Style="{DynamicResource NowCardStyle}" Margin="0,0,0,8">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Border x:Name="NowThumb" Width="46" Height="30" CornerRadius="{DynamicResource RSmall}" Background="{DynamicResource ThumbBg}">
                <TextBlock x:Name="NowGlyph" Text="&#xE91B;" FontFamily="{DynamicResource IconFont}" FontSize="13" Foreground="{DynamicResource Fg3}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <StackPanel Grid.Column="1" Margin="10,0,4,0" VerticalAlignment="Center">
                <TextBlock x:Name="NowLabel" Text="Aucun fond animé" FontSize="11" Foreground="{DynamicResource Fg2}" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="NowName" Text="Choisissez un fond" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" FontSize="12"/>
              </StackPanel>
              <StackPanel x:Name="NowButtons" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                <Button x:Name="BtnNowPause" Style="{DynamicResource ToolBtnSmall}" Content="&#xE769;" ToolTip="Pause"/>
                <Button x:Name="BtnNowStop" Style="{DynamicResource ToolBtnSmall}" Content="&#xE71A;" ToolTip="Arrêter le fond animé"/>
              </StackPanel>
            </Grid>
          </ContentControl>
          <Grid>
            <Button x:Name="BtnSettings" Style="{DynamicResource SideBtn}" HorizontalAlignment="Left">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE713;" FontFamily="{DynamicResource IconFont}" FontSize="14" Foreground="{DynamicResource Fg2}" VerticalAlignment="Center"/>
                <TextBlock Text="Réglages" Margin="9,0,0,0" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button x:Name="BtnTheme" Style="{DynamicResource ToolBtn}" HorizontalAlignment="Right" FontSize="14" Content="&#xE708;" ToolTip="Basculer clair / sombre"/>
          </Grid>
        </StackPanel>

        <DockPanel>
          <Grid DockPanel.Dock="Top" Margin="20,2,12,6">
            <TextBlock Text="Bibliothèques" Style="{DynamicResource SectionHeader}" VerticalAlignment="Center"/>
            <Button x:Name="BtnNewFolderSide" Style="{DynamicResource ToolBtnSmall}" HorizontalAlignment="Right" Content="&#xE710;" ToolTip="Nouvelle bibliothèque"/>
          </Grid>
          <TreeView x:Name="Tree" Style="{DynamicResource SidebarTree}" ItemTemplate="{DynamicResource FolderTpl}"/>
        </DockPanel>
      </DockPanel>
    </Border>

    <!-- ======================= CONTENT ======================= -->
    <Border x:Name="Content" Grid.Row="1" Grid.Column="1" Background="{DynamicResource ContentBg}" BorderBrush="{DynamicResource Separator}" BorderThickness="1,0,0,0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="52"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition x:Name="InspCol" Width="304"/>
        </Grid.ColumnDefinitions>

        <!-- Windows-style caption buttons (Base interface) -->
        <StackPanel x:Name="CaptionPanel" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Visibility="Collapsed" shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Button x:Name="CBtnMin" Style="{DynamicResource CaptionBtn}" Content="&#xE921;" ToolTip="Réduire"/>
          <Button x:Name="CBtnMax" Style="{DynamicResource CaptionBtn}" Content="&#xE922;" ToolTip="Agrandir"/>
          <Button x:Name="CBtnClose" Style="{DynamicResource CaptionCloseBtn}" Content="&#xE8BB;" ToolTip="Fermer"/>
        </StackPanel>

        <!-- toolbar -->
        <DockPanel x:Name="ToolbarDock" Grid.ColumnSpan="2" Margin="10,0,14,0">
          <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Button x:Name="BtnBack" Style="{DynamicResource ToolBtn}" Content="&#xE76B;" ToolTip="Précédent"/>
            <Button x:Name="BtnFwd" Style="{DynamicResource ToolBtn}" Content="&#xE76C;" ToolTip="Suivant"/>
          </StackPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <TextBlock Text="&#xE8B9;" FontFamily="{DynamicResource IconFont}" FontSize="11" Foreground="{DynamicResource Fg3}" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <Slider x:Name="ZoomSlider" Width="78" Minimum="150" Maximum="320" Value="200" VerticalAlignment="Center" Margin="0,0,6,0" ToolTip="Taille des vignettes"/>
            <TextBlock Text="&#xE8B9;" FontFamily="{DynamicResource IconFont}" FontSize="15" Foreground="{DynamicResource Fg3}" VerticalAlignment="Center" Margin="0,0,16,0"/>
            <TextBox x:Name="Search" Style="{DynamicResource SearchBox}" Width="200" Tag="Rechercher" Margin="0,0,8,0"/>
            <Button x:Name="BtnNewFolder" Style="{DynamicResource ToolBtn}" Content="&#xE8F4;" ToolTip="Nouveau dossier"/>
            <Button x:Name="BtnInspector" Style="{DynamicResource ToolBtn}" Content="&#xE8A0;" ToolTip="Afficher / masquer l'inspecteur"/>
            <Button x:Name="BtnImport" Style="{DynamicResource PrimaryBtnSmall}" Margin="8,0,0,0" ToolTip="Ajouter des vidéos ou des images">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE710;" FontFamily="{DynamicResource IconFont}" FontSize="11" VerticalAlignment="Center" Margin="0,1,7,0"/>
                <TextBlock Text="Importer" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </StackPanel>
          <StackPanel VerticalAlignment="Center" Margin="10,0,12,0" IsHitTestVisible="False">
            <TextBlock x:Name="TitleText" Text="Tous les fonds" FontFamily="{DynamicResource DisplayFont}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="SubtitleText" FontSize="11" Foreground="{DynamicResource Fg2}" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
        </DockPanel>
        <Border Grid.ColumnSpan="2" VerticalAlignment="Bottom" Height="1" Background="{DynamicResource Separator}"/>

        <!-- gallery -->
        <Grid x:Name="DropZone" Grid.Row="1" AllowDrop="True" Background="Transparent">
          <ListBox x:Name="List" Style="{DynamicResource Gallery}" AllowDrop="True"/>
          <StackPanel x:Name="Empty" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" Margin="20">
            <Border Width="84" Height="84" CornerRadius="{DynamicResource RHero}" Background="{DynamicResource ThumbBg}" HorizontalAlignment="Center">
              <TextBlock Text="&#xE898;" FontFamily="{DynamicResource IconFont}" FontSize="34" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock x:Name="EmptyTitle" Text="Glissez vos vidéos et images ici" FontFamily="{DynamicResource DisplayFont}" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,18,0,6"/>
            <TextBlock x:Name="EmptySub" Text="ou cliquez sur Importer" Foreground="{DynamicResource Fg2}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
          </StackPanel>
          <Border x:Name="DropOverlay" Margin="12" CornerRadius="{DynamicResource RSheet}" BorderThickness="2" BorderBrush="{DynamicResource Accent}" Background="{DynamicResource AccentSoft}" Visibility="Collapsed" IsHitTestVisible="False">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
              <TextBlock Text="&#xE896;" FontFamily="{DynamicResource IconFont}" FontSize="34" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"/>
              <TextBlock x:Name="DropText" Text="Déposer pour importer" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" Margin="0,10,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
          </Border>
        </Grid>

        <!-- inspector -->
        <Border x:Name="InspectorPane" Grid.Row="1" Grid.Column="1" Background="{DynamicResource InspectorBg}" BorderBrush="{DynamicResource Separator}" BorderThickness="1,0,0,0">
          <ScrollViewer x:Name="InspScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <Grid Margin="18,18,18,26">

              <!-- item -->
              <StackPanel x:Name="InspItem" Visibility="Collapsed">
                <Border x:Name="PreviewBox" CornerRadius="{DynamicResource RThumb}" Height="150" Background="#000000">
                  <Grid>
                    <Border x:Name="PreviewImage" CornerRadius="{DynamicResource RThumb}"/>
                    <ContentControl x:Name="PreviewSlot" Focusable="False"/>
                  </Grid>
                </Border>
                <TextBlock x:Name="InspName" FontFamily="{DynamicResource DisplayFont}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,14,0,3"/>
                <TextBlock x:Name="InspSub" FontSize="12" Foreground="{DynamicResource Fg2}" TextWrapping="Wrap"/>
                <TextBlock x:Name="PreviewError" FontSize="12" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>
                <Button x:Name="BtnStore" Style="{DynamicResource LinkBtn}" Content="Ouvrir le Microsoft Store" HorizontalAlignment="Left" Margin="0,4,0,0" Visibility="Collapsed"/>
                <Button x:Name="BtnApply" Style="{DynamicResource PrimaryBtn}" Margin="0,14,0,0">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="ApplyGlyph" Text="&#xE7F4;" FontFamily="{DynamicResource IconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,1,8,0"/>
                    <TextBlock x:Name="ApplyText" Text="Définir comme fond d'écran" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>

                <TextBlock Text="Affichage" Style="{DynamicResource InspHeader}"/>
                <ContentControl x:Name="SegFitSlot" Focusable="False"/>

                <StackPanel x:Name="VideoOpts">
                  <DockPanel Margin="0,20,0,4">
                    <TextBlock x:Name="TrimInfo" DockPanel.Dock="Right" FontSize="11" Foreground="{DynamicResource Fg2}" VerticalAlignment="Bottom"/>
                    <TextBlock Text="Partie lue" Style="{DynamicResource InspHeaderInline}"/>
                  </DockPanel>
                  <ContentControl x:Name="TrimSlot" Focusable="False"/>
                  <DockPanel Margin="0,0,0,0">
                    <TextBlock x:Name="TrimEndText" DockPanel.Dock="Right" FontSize="11" Foreground="{DynamicResource Fg2}"/>
                    <TextBlock x:Name="TrimStartText" FontSize="11" Foreground="{DynamicResource Fg2}"/>
                  </DockPanel>

                  <TextBlock Text="Vitesse" Style="{DynamicResource InspHeader}"/>
                  <ContentControl x:Name="SegSpeedSlot" Focusable="False"/>

                  <TextBlock Text="Boucle" Style="{DynamicResource InspHeader}"/>
                  <ContentControl x:Name="SegLoopSlot" Focusable="False"/>
                  <StackPanel x:Name="PausePanel" Margin="0,12,0,0">
                    <DockPanel>
                      <TextBlock x:Name="PauseText" DockPanel.Dock="Right" FontSize="12" Foreground="{DynamicResource Fg2}"/>
                      <TextBlock Text="Pause entre deux lectures" FontSize="12"/>
                    </DockPanel>
                    <Slider x:Name="PauseSlider" Minimum="1" Maximum="60" Value="3" IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,6,0,0"/>
                  </StackPanel>
                  <Border x:Name="LoopFadeBox" Style="{DynamicResource Group}" Margin="0,12,0,0">
                    <CheckBox x:Name="SwLoopFade" Style="{DynamicResource Switch}" Content="Fondu à chaque boucle"/>
                  </Border>

                  <TextBlock Text="Son" Style="{DynamicResource InspHeader}"/>
                  <DockPanel>
                    <TextBlock x:Name="VolIcon" Text="&#xE74F;" FontFamily="{DynamicResource IconFont}" FontSize="14" Foreground="{DynamicResource Fg2}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock x:Name="VolText" DockPanel.Dock="Right" FontSize="12" Foreground="{DynamicResource Fg2}" Width="40" TextAlignment="Right" VerticalAlignment="Center"/>
                    <Slider x:Name="VolSlider" Minimum="0" Maximum="100" Value="0" VerticalAlignment="Center"/>
                  </DockPanel>
                </StackPanel>
                <Button x:Name="BtnReset" Style="{DynamicResource LinkBtn}" Content="Réinitialiser les réglages" HorizontalAlignment="Left" Margin="0,22,0,0"/>
              </StackPanel>

              <!-- folder -->
              <StackPanel x:Name="InspFolder">
                <Image Source="{DynamicResource FolderArt}" Width="104" Height="86" Margin="0,6,0,0"/>
                <TextBlock x:Name="FolderName" FontFamily="{DynamicResource DisplayFont}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,12,0,2"/>
                <TextBlock x:Name="FolderSub" FontSize="12" Foreground="{DynamicResource Fg2}" HorizontalAlignment="Center"/>
                <Button x:Name="BtnPlayFolder" Style="{DynamicResource PrimaryBtn}" Margin="0,16,0,0">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="PlayFolderGlyph" Text="&#xE768;" FontFamily="{DynamicResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,1,8,0"/>
                    <TextBlock x:Name="PlayFolderText" Text="Lire ce dossier en fond d'écran" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>

                <TextBlock Text="Ordre de lecture" Style="{DynamicResource InspHeader}"/>
                <ContentControl x:Name="SegOrderSlot" Focusable="False"/>
                <Border Style="{DynamicResource Group}" Margin="0,12,0,0">
                  <CheckBox x:Name="SwRecursive" Style="{DynamicResource Switch}" Content="Inclure les sous-dossiers"/>
                </Border>

                <DockPanel Margin="0,20,0,4">
                  <TextBlock x:Name="ImgDurText" DockPanel.Dock="Right" FontSize="11" Foreground="{DynamicResource Fg2}" VerticalAlignment="Bottom"/>
                  <TextBlock Text="Durée de chaque image" Style="{DynamicResource InspHeaderInline}"/>
                </DockPanel>
                <Slider x:Name="ImgDurSlider" Minimum="0" Maximum="9" IsSnapToTickEnabled="True" TickFrequency="1"/>

                <TextBlock Text="Lectures de chaque vidéo avant la suivante" Style="{DynamicResource InspHeader}"/>
                <ContentControl x:Name="SegLoopsSlot" Focusable="False"/>
              </StackPanel>

              <!-- multi -->
              <StackPanel x:Name="InspMulti" Visibility="Collapsed">
                <TextBlock x:Name="MultiText" FontFamily="{DynamicResource DisplayFont}" FontSize="16" FontWeight="SemiBold" Margin="0,6,0,4"/>
                <Button x:Name="BtnMultiMove" Style="{DynamicResource PushBtn}" Content="Déplacer vers…" Margin="0,16,0,0"/>
                <Button x:Name="BtnMultiDelete" Style="{DynamicResource PushBtn}" Content="Mettre à la corbeille" Margin="0,8,0,0"/>
              </StackPanel>
            </Grid>
          </ScrollViewer>
        </Border>
      </Grid>
    </Border>

    <!-- ======================= SHEETS ======================= -->
    <Grid x:Name="SheetLayer" Grid.RowSpan="2" Grid.ColumnSpan="2" Visibility="Collapsed" Background="{DynamicResource Dim}">
      <ContentControl x:Name="SheetCard" Style="{DynamicResource SheetFrame}" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,58,0,24">
        <ContentControl.RenderTransform>
          <TranslateTransform/>
        </ContentControl.RenderTransform>
        <Grid>
          <!-- first run -->
          <StackPanel x:Name="SetupPanel" Width="470" Margin="32,28,32,28" Visibility="Collapsed">
            <Image x:Name="SetupLogo" Width="76" Height="76" HorizontalAlignment="Center"/>
            <TextBlock Text="Bienvenue dans CL-Wallpaper" FontFamily="{DynamicResource DisplayFont}" FontSize="21" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,8"/>
            <TextBlock TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource Fg2}"
                       Text="Choisissez où créer le répertoire de l'application. Vos bibliothèques, les fonds d'écran importés et les réglages y seront rangés."/>
            <TextBlock Text="Répertoire de l'application" Style="{DynamicResource InspHeader}"/>
            <DockPanel>
              <Button x:Name="BtnSetupBrowse" DockPanel.Dock="Right" Style="{DynamicResource PushBtn}" Content="Choisir…" Margin="8,0,0,0"/>
              <TextBox x:Name="SetupPath" Style="{DynamicResource Field}"/>
            </DockPanel>
            <CheckBox x:Name="ChkInstall" Style="{DynamicResource MacCheck}" Margin="0,18,0,0" Content="Copier l'application (CL-Wallpaper.exe) dans ce répertoire"/>
            <CheckBox x:Name="ChkStartMenu" Style="{DynamicResource MacCheck}" Margin="0,10,0,0" Content="Ajouter au menu Démarrer"/>
            <CheckBox x:Name="ChkDesktop" Style="{DynamicResource MacCheck}" Margin="0,10,0,0" Content="Créer un raccourci sur le Bureau"/>
            <TextBlock x:Name="SetupError" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed"/>
            <Button x:Name="BtnSetupGo" Style="{DynamicResource PrimaryBtn}" Content="Créer le répertoire et commencer" Margin="0,24,0,0"/>
          </StackPanel>

          <!-- settings -->
          <StackPanel x:Name="SettingsPanel" Width="490" Margin="26,22,8,24" Visibility="Collapsed">
            <DockPanel Margin="0,0,18,0">
              <Button x:Name="BtnSettingsDone" DockPanel.Dock="Right" Style="{DynamicResource PrimaryBtnSmall}" Content="Terminé" MinWidth="80"/>
              <TextBlock Text="Réglages" FontFamily="{DynamicResource DisplayFont}" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </DockPanel>
            <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Margin="0,4,0,0">
            <StackPanel Margin="0,0,18,4">
            <TextBlock Text="Interface" Style="{DynamicResource InspHeader}"/>
            <ContentControl x:Name="SegStyleSlot" Focusable="False"/>
            <TextBlock Text="Apparence" Style="{DynamicResource InspHeader}"/>
            <ContentControl x:Name="SegThemeSlot" Focusable="False"/>
            <TextBlock Text="Général" Style="{DynamicResource InspHeader}"/>
            <Border Style="{DynamicResource Group}">
              <StackPanel>
                <CheckBox x:Name="SwAutostart" Style="{DynamicResource Switch}" Content="Lancer le fond d'écran au démarrage de Windows"/>
                <Border Style="{DynamicResource GroupSep}"/>
                <CheckBox x:Name="SwMute" Style="{DynamicResource Switch}" Content="Couper le son de tous les fonds"/>
                <Border Style="{DynamicResource GroupSep}"/>
                <CheckBox x:Name="SwFade" Style="{DynamicResource Switch}" Content="Fondu entre deux fonds"/>
                <Border Style="{DynamicResource GroupSep}"/>
                <CheckBox x:Name="SwConvertGif" Style="{DynamicResource Switch}" Content="Convertir les GIF animés en MP4 à l'import (bien plus léger)"/>
              </StackPanel>
            </Border>
            <TextBlock Text="Jour et nuit" Style="{DynamicResource InspHeader}"/>
            <Border Style="{DynamicResource Group}">
              <StackPanel>
                <CheckBox x:Name="SwSchedule" Style="{DynamicResource Switch}" Content="Changer de fond selon l'heure"/>
                <Border Style="{DynamicResource GroupSep}"/>
                <DockPanel Margin="0,2,0,2">
                  <TextBox x:Name="DayTime" DockPanel.Dock="Right" Style="{DynamicResource Field}" Width="64" TextAlignment="Center"/>
                  <TextBlock DockPanel.Dock="Right" Text="à partir de" Foreground="{DynamicResource Fg2}" VerticalAlignment="Center" Margin="8,0,8,0"/>
                  <TextBlock Text="&#xE706;" FontFamily="{DynamicResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                  <TextBlock x:Name="DayName" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
                <Border Style="{DynamicResource GroupSep}"/>
                <DockPanel Margin="0,2,0,2">
                  <TextBox x:Name="NightTime" DockPanel.Dock="Right" Style="{DynamicResource Field}" Width="64" TextAlignment="Center"/>
                  <TextBlock DockPanel.Dock="Right" Text="à partir de" Foreground="{DynamicResource Fg2}" VerticalAlignment="Center" Margin="8,0,8,0"/>
                  <TextBlock Text="&#xE708;" FontFamily="{DynamicResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                  <TextBlock x:Name="NightName" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
              </StackPanel>
            </Border>
            <TextBlock Text="Écrans" Style="{DynamicResource InspHeader}"/>
            <ContentControl x:Name="SegMonitorsSlot" Focusable="False"/>
            <TextBlock Text="Économie d'énergie" Style="{DynamicResource InspHeader}"/>
            <Border Style="{DynamicResource Group}">
              <StackPanel>
                <CheckBox x:Name="SwFullscreen" Style="{DynamicResource Switch}" Content="Pause quand une application est en plein écran"/>
                <Border Style="{DynamicResource GroupSep}"/>
                <CheckBox x:Name="SwMaximized" Style="{DynamicResource Switch}" Content="Pause quand une fenêtre recouvre l'écran"/>
                <Border Style="{DynamicResource GroupSep}"/>
                <CheckBox x:Name="SwBattery" Style="{DynamicResource Switch}" Content="Pause sur batterie"/>
              </StackPanel>
            </Border>
            <TextBlock Text="Répertoire de l'application" Style="{DynamicResource InspHeader}"/>
            <DockPanel>
              <Button x:Name="BtnOpenData" DockPanel.Dock="Right" Style="{DynamicResource PushBtn}" Content="Ouvrir" Margin="10,0,0,0"/>
              <TextBlock x:Name="DataPathText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Fg2}"/>
            </DockPanel>
            <TextBlock Text="Mises à jour" Style="{DynamicResource InspHeader}"/>
            <Border Style="{DynamicResource Group}">
              <StackPanel>
                <CheckBox x:Name="SwUpdateCheck" Style="{DynamicResource Switch}" Content="Vérifier au démarrage"/>
                <Border Style="{DynamicResource GroupSep}"/>
                <TextBlock Text="Source (URL d'un manifeste JSON, ou github:propriétaire/dépôt)" FontSize="11" Foreground="{DynamicResource Fg2}" Margin="0,2,0,4"/>
                <TextBox x:Name="UpdateSource" Style="{DynamicResource Field}" Margin="0,0,0,2"/>
              </StackPanel>
            </Border>
            <DockPanel Margin="0,10,0,0">
              <Button x:Name="BtnCheckUpdate" DockPanel.Dock="Right" Style="{DynamicResource PushBtn}" Content="Rechercher" Margin="10,0,0,0"/>
              <Button x:Name="BtnUpdateFile" DockPanel.Dock="Right" Style="{DynamicResource PushBtn}" Content="Depuis un fichier…" Margin="10,0,0,0"/>
              <TextBlock x:Name="UpdateStatus" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource Fg2}"/>
            </DockPanel>
            </StackPanel>
            </ScrollViewer>
          </StackPanel>

          <!-- prompt / confirm -->
          <StackPanel x:Name="PromptPanel" Width="390" Margin="24,22,24,20" Visibility="Collapsed">
            <TextBlock x:Name="PromptTitle" FontFamily="{DynamicResource DisplayFont}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock x:Name="PromptMsg" TextWrapping="Wrap" Foreground="{DynamicResource Fg2}" Margin="0,6,0,0"/>
            <TextBox x:Name="PromptInput" Style="{DynamicResource Field}" Margin="0,14,0,0"/>
            <TextBlock x:Name="PromptError" Foreground="{DynamicResource Danger}" Margin="0,8,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
              <Button x:Name="BtnPromptCancel" Style="{DynamicResource PushBtn}" Content="Annuler" MinWidth="92"/>
              <Button x:Name="BtnPromptOk" Style="{DynamicResource PrimaryBtnSmall}" Height="30" Content="OK" MinWidth="92" Margin="10,0,0,0"/>
            </StackPanel>
          </StackPanel>

          <!-- move to -->
          <StackPanel x:Name="MovePanel" Width="390" Margin="24,22,24,20" Visibility="Collapsed">
            <TextBlock x:Name="MoveTitle" Text="Déplacer vers…" FontFamily="{DynamicResource DisplayFont}" FontSize="16" FontWeight="SemiBold"/>
            <ListBox x:Name="MoveList" Style="{DynamicResource PlainList}" ItemTemplate="{DynamicResource MoveItemTpl}" Height="270" Margin="0,14,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
              <Button x:Name="BtnMoveCancel" Style="{DynamicResource PushBtn}" Content="Annuler" MinWidth="92"/>
              <Button x:Name="BtnMoveOk" Style="{DynamicResource PrimaryBtnSmall}" Height="30" Content="Déplacer" MinWidth="92" Margin="10,0,0,0"/>
            </StackPanel>
          </StackPanel>
        </Grid>
      </ContentControl>
    </Grid>

    <!-- toast -->
    <Border x:Name="Toast" Grid.Row="1" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,26" CornerRadius="{DynamicResource RToast}" Padding="18,9"
            Background="{DynamicResource ToastBg}" BorderBrush="{DynamicResource ToastBorder}" BorderThickness="1" Opacity="0" IsHitTestVisible="False">
      <Border.Effect>
        <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.25"/>
      </Border.Effect>
      <TextBlock x:Name="ToastText" Foreground="{DynamicResource ToastFg}" FontWeight="SemiBold"/>
    </Border>
  </Grid>
  </ContentControl>
</Window>
