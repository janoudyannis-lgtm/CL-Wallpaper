<!-- Templates for the "Old School" interface (Windows 98 look). Same keys as Modern.xaml. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <BooleanToVisibilityConverter x:Key="B2V"/>

  <!-- ======================= bevel building blocks ======================= -->
  <Style x:Key="BevelRaised" TargetType="ContentControl">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Background" Value="{DynamicResource Face}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContentControl">
          <Border BorderBrush="{DynamicResource BevelDark}" BorderThickness="0,0,1,1">
            <Border BorderBrush="{DynamicResource BevelLight}" BorderThickness="1,1,0,0">
              <Border BorderBrush="{DynamicResource BevelShadow}" BorderThickness="0,0,1,1">
                <Border BorderBrush="{DynamicResource BevelLight2}" BorderThickness="1,1,0,0" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                  <ContentPresenter/>
                </Border>
              </Border>
            </Border>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="BevelWindow" TargetType="ContentControl" BasedOn="{StaticResource BevelRaised}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContentControl">
          <Border BorderBrush="{DynamicResource BevelDark}" BorderThickness="0,0,1,1">
            <Border BorderBrush="{DynamicResource BevelLight2}" BorderThickness="1,1,0,0">
              <Border BorderBrush="{DynamicResource BevelShadow}" BorderThickness="0,0,1,1">
                <Border BorderBrush="{DynamicResource BevelLight}" BorderThickness="1,1,0,0" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                  <ContentPresenter/>
                </Border>
              </Border>
            </Border>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="BevelSunken" TargetType="ContentControl" BasedOn="{StaticResource BevelRaised}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContentControl">
          <Border BorderBrush="{DynamicResource BevelLight}" BorderThickness="0,0,1,1">
            <Border BorderBrush="{DynamicResource BevelShadow}" BorderThickness="1,1,0,0">
              <Border BorderBrush="{DynamicResource BevelLight2}" BorderThickness="0,0,1,1">
                <Border BorderBrush="{DynamicResource BevelDark}" BorderThickness="1,1,0,0" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                  <ContentPresenter/>
                </Border>
              </Border>
            </Border>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="BevelPressed" TargetType="ContentControl" BasedOn="{StaticResource BevelRaised}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContentControl">
          <Border BorderBrush="{DynamicResource BevelDark}" BorderThickness="1">
            <Border BorderBrush="{DynamicResource BevelShadow}" BorderThickness="1" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
              <ContentPresenter Margin="1,1,-1,-1"/>
            </Border>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="BevelDefault" TargetType="ContentControl" BasedOn="{StaticResource BevelRaised}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContentControl">
          <Border BorderBrush="{DynamicResource BevelDark}" BorderThickness="1">
            <Border BorderBrush="{DynamicResource BevelDark}" BorderThickness="0,0,1,1">
              <Border BorderBrush="{DynamicResource BevelLight}" BorderThickness="1,1,0,0">
                <Border BorderBrush="{DynamicResource BevelShadow}" BorderThickness="0,0,1,1">
                  <Border BorderBrush="{DynamicResource BevelLight2}" BorderThickness="1,1,0,0" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                    <ContentPresenter/>
                  </Border>
                </Border>
              </Border>
            </Border>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="BevelThin" TargetType="ContentControl" BasedOn="{StaticResource BevelRaised}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContentControl">
          <Border BorderBrush="{DynamicResource BevelShadow}" BorderThickness="0,0,1,1">
            <Border BorderBrush="{DynamicResource BevelLight}" BorderThickness="1,1,0,0" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
              <ContentPresenter/>
            </Border>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="BevelThinSunken" TargetType="ContentControl" BasedOn="{StaticResource BevelRaised}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContentControl">
          <Border BorderBrush="{DynamicResource BevelLight}" BorderThickness="0,0,1,1">
            <Border BorderBrush="{DynamicResource BevelShadow}" BorderThickness="1,1,0,0" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
              <ContentPresenter Margin="1,1,-1,-1"/>
            </Border>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="BevelFlat" TargetType="ContentControl" BasedOn="{StaticResource BevelRaised}">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContentControl">
          <Border BorderBrush="Transparent" BorderThickness="1" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
            <ContentPresenter/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ======================= text ======================= -->
  <Style x:Key="InspHeader" TargetType="TextBlock">
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
    <Setter Property="Margin" Value="0,16,0,6"/>
  </Style>
  <Style x:Key="InspHeaderInline" TargetType="TextBlock">
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
  </Style>
  <Style x:Key="SectionHeader" TargetType="TextBlock">
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
  </Style>

  <!-- ======================= frames ======================= -->
  <Style x:Key="WindowFrame" TargetType="ContentControl" BasedOn="{StaticResource BevelWindow}">
    <Setter Property="Padding" Value="2"/>
  </Style>
  <Style x:Key="SheetFrame" TargetType="ContentControl" BasedOn="{StaticResource BevelWindow}">
    <Setter Property="Padding" Value="1"/>
  </Style>
  <Style x:Key="NowCardStyle" TargetType="ContentControl" BasedOn="{StaticResource BevelSunken}">
    <Setter Property="Padding" Value="6"/>
  </Style>

  <!-- ======================= buttons ======================= -->
  <Style x:Key="ToolBtn" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
    <Setter Property="FontFamily" Value="{DynamicResource IconFont}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Width" Value="28"/>
    <Setter Property="Height" Value="26"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <ContentControl x:Name="Box" Style="{StaticResource BevelFlat}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </ContentControl>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Box" Property="Style" Value="{StaticResource BevelThin}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Box" Property="Style" Value="{StaticResource BevelThinSunken}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource Fg3}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="ToolBtnSmall" TargetType="Button" BasedOn="{StaticResource ToolBtn}">
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Width" Value="22"/>
    <Setter Property="Height" Value="20"/>
  </Style>
  <Style x:Key="CaptionBtn" TargetType="Button" BasedOn="{StaticResource ToolBtn}"/>
  <Style x:Key="CaptionCloseBtn" TargetType="Button" BasedOn="{StaticResource ToolBtn}"/>

  <!-- title-bar buttons ( _ □ × ) -->
  <Style x:Key="TitleBtn" TargetType="Button">
    <Setter Property="Width" Value="16"/>
    <Setter Property="Height" Value="14"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <ContentControl x:Name="Box" Style="{StaticResource BevelRaised}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </ContentControl>
          <ControlTemplate.Triggers>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Box" Property="Style" Value="{StaticResource BevelPressed}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SideBtn" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Height" Value="26"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <ContentControl x:Name="Box" Style="{StaticResource BevelFlat}" Padding="6,0,8,0">
            <ContentPresenter VerticalAlignment="Center"/>
          </ContentControl>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Box" Property="Style" Value="{StaticResource BevelThin}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Box" Property="Style" Value="{StaticResource BevelThinSunken}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="PushBtn" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
    <Setter Property="Background" Value="{DynamicResource Face}"/>
    <Setter Property="Padding" Value="12,0"/>
    <Setter Property="Height" Value="24"/>
    <Setter Property="MinWidth" Value="75"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <ContentControl x:Name="Box" Style="{StaticResource BevelRaised}" Background="{TemplateBinding Background}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
          </ContentControl>
          <ControlTemplate.Triggers>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Box" Property="Style" Value="{StaticResource BevelPressed}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource Fg3}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="PrimaryBtn" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
    <Setter Property="Background" Value="{DynamicResource Face}"/>
    <Setter Property="Padding" Value="12,0"/>
    <Setter Property="Height" Value="28"/>
    <Setter Property="MinWidth" Value="75"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <ContentControl x:Name="Box" Style="{StaticResource BevelDefault}" Background="{TemplateBinding Background}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
          </ContentControl>
          <ControlTemplate.Triggers>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Box" Property="Style" Value="{StaticResource BevelPressed}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource Fg3}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="PrimaryBtnSmall" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
    <Setter Property="Height" Value="24"/>
  </Style>
  <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}"/>
  <Style x:Key="ActiveBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <ContentControl x:Name="Box" Style="{StaticResource BevelSunken}" Background="{DynamicResource Dither}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
          </ContentControl>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="LinkBtn" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource Link}"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" TextDecorations="Underline" Background="Transparent"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Light" TargetType="Button">
    <Setter Property="Width" Value="12"/>
    <Setter Property="Height" Value="12"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Ellipse Fill="{TemplateBinding Background}"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ======================= "segmented" = toolbar toggle buttons ======================= -->
  <Style x:Key="SegHost" TargetType="Border">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Padding" Value="0"/>
  </Style>
  <Style x:Key="Seg" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
    <Setter Property="Height" Value="24"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <ContentControl x:Name="Box" Style="{StaticResource BevelRaised}" Margin="0,0,2,0">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3,0"/>
          </ContentControl>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Box" Property="Style" Value="{StaticResource BevelSunken}"/>
              <Setter TargetName="Box" Property="Background" Value="{DynamicResource Dither}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ======================= checkboxes ======================= -->
  <Style x:Key="Switch" TargetType="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ContentControl Style="{StaticResource BevelSunken}" Background="{DynamicResource FieldBg}" Width="13" Height="13" VerticalAlignment="Center">
              <Path x:Name="Tick" Data="M0,2.5 L2.5,5 L7,0.5" Stroke="{DynamicResource Fg}" StrokeThickness="1.8" Visibility="Hidden" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </ContentControl>
            <ContentPresenter Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="MacCheck" TargetType="CheckBox" BasedOn="{StaticResource Switch}"/>

  <!-- ======================= slider ======================= -->
  <Style x:Key="Knob" TargetType="Thumb">
    <Setter Property="Width" Value="11"/>
    <Setter Property="Height" Value="21"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <ContentControl Style="{StaticResource BevelRaised}"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="SliderFill" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Border Background="Transparent"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="SliderEmpty" TargetType="RepeatButton" BasedOn="{StaticResource SliderFill}"/>
  <Style TargetType="Slider">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="IsMoveToPointEnabled" Value="True"/>
    <Setter Property="Height" Value="24"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Slider">
          <Grid Background="Transparent">
            <ContentControl Style="{StaticResource BevelSunken}" Height="4" Margin="4,0" VerticalAlignment="Center"/>
            <Track x:Name="PART_Track">
              <Track.DecreaseRepeatButton>
                <RepeatButton Style="{StaticResource SliderFill}"/>
              </Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton>
                <RepeatButton Style="{StaticResource SliderEmpty}"/>
              </Track.IncreaseRepeatButton>
              <Track.Thumb>
                <Thumb Style="{StaticResource Knob}"/>
              </Track.Thumb>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ======================= scrollbar (classic, with arrows) ======================= -->
  <Style x:Key="ScrollThumb" TargetType="Thumb">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <ContentControl Style="{StaticResource BevelRaised}"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="ScrollArrow" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <ContentControl x:Name="Box" Style="{StaticResource BevelRaised}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </ContentControl>
          <ControlTemplate.Triggers>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Box" Property="Style" Value="{StaticResource BevelPressed}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="16"/>
    <Setter Property="MinWidth" Value="16"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="{DynamicResource Dither}">
            <Grid.RowDefinitions>
              <RowDefinition Height="16"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="16"/>
            </Grid.RowDefinitions>
            <RepeatButton Style="{StaticResource ScrollArrow}" Command="ScrollBar.LineUpCommand">
              <Path Data="M0,4 L3.5,0 L7,4 Z" Fill="{DynamicResource Fg}"/>
            </RepeatButton>
            <Track x:Name="PART_Track" Grid.Row="1" IsDirectionReversed="True">
              <Track.DecreaseRepeatButton>
                <RepeatButton Style="{StaticResource SliderEmpty}" Command="ScrollBar.PageUpCommand"/>
              </Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton>
                <RepeatButton Style="{StaticResource SliderEmpty}" Command="ScrollBar.PageDownCommand"/>
              </Track.IncreaseRepeatButton>
              <Track.Thumb>
                <Thumb Style="{StaticResource ScrollThumb}" MinHeight="16"/>
              </Track.Thumb>
            </Track>
            <RepeatButton Grid.Row="2" Style="{StaticResource ScrollArrow}" Command="ScrollBar.LineDownCommand">
              <Path Data="M0,0 L7,0 L3.5,4 Z" Fill="{DynamicResource Fg}"/>
            </RepeatButton>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ======================= text boxes ======================= -->
  <Style x:Key="SearchBox" TargetType="TextBox">
    <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
    <Setter Property="CaretBrush" Value="{DynamicResource Fg}"/>
    <Setter Property="Height" Value="22"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <ContentControl Style="{StaticResource BevelSunken}" Background="{DynamicResource FieldBg}">
            <Grid Margin="4,0,3,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="&#xE721;" FontFamily="{DynamicResource IconFont}" FontSize="11" Foreground="{DynamicResource Fg}" VerticalAlignment="Center" Margin="0,1,5,0"/>
              <TextBlock x:Name="Ph" Grid.Column="1" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{DynamicResource Fg3}" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False" Margin="2,0,0,0"/>
              <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" VerticalAlignment="Center" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
            </Grid>
          </ContentControl>
          <ControlTemplate.Triggers>
            <Trigger Property="Text" Value="">
              <Setter TargetName="Ph" Property="Visibility" Value="Visible"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Field" TargetType="TextBox">
    <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
    <Setter Property="CaretBrush" Value="{DynamicResource Fg}"/>
    <Setter Property="Height" Value="24"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <ContentControl Style="{StaticResource BevelSunken}" Background="{DynamicResource FieldBg}" Padding="3,0">
            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
          </ContentControl>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ======================= group boxes ======================= -->
  <Style x:Key="Group" TargetType="Border">
    <Setter Property="BorderBrush" Value="{DynamicResource BevelShadow}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Padding" Value="10,7"/>
  </Style>
  <Style x:Key="GroupSep" TargetType="Border">
    <Setter Property="Height" Value="2"/>
    <Setter Property="Background" Value="{DynamicResource EtchedH}"/>
    <Setter Property="Margin" Value="0,7"/>
  </Style>

  <!-- ======================= tree (Explorer 98) ======================= -->
  <Style x:Key="SidebarTree" TargetType="TreeView">
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TreeView">
          <ContentControl Style="{StaticResource BevelSunken}" Background="{DynamicResource ListBg}" Margin="8,0,8,0">
            <ScrollViewer Focusable="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="2,3">
              <ItemsPresenter/>
            </ScrollViewer>
          </ContentControl>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="TreeExpander" TargetType="ToggleButton">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border Width="16" Height="18" Background="Transparent">
            <Border Width="9" Height="9" BorderBrush="{DynamicResource BevelShadow}" BorderThickness="1" Background="{DynamicResource ListBg}" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Grid>
                <Rectangle Width="5" Height="1" Fill="{DynamicResource Fg}"/>
                <Rectangle x:Name="V" Width="1" Height="5" Fill="{DynamicResource Fg}"/>
              </Grid>
            </Border>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="V" Property="Visibility" Value="Collapsed"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="TreeViewItem">
    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
    <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="AllowDrop" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TreeViewItem">
          <StackPanel>
            <Grid Height="20">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding Indent}"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <ToggleButton x:Name="Exp" Grid.Column="1" Style="{StaticResource TreeExpander}" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press"/>
              <Border x:Name="Bd" Grid.Column="2" Background="Transparent" Padding="2,0,3,0" Margin="1,1,4,1">
                <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
              </Border>
            </Grid>
            <ItemsPresenter x:Name="ItemsHost"/>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsExpanded" Value="False">
              <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="HasItems" Value="False">
              <Setter TargetName="Exp" Property="Visibility" Value="Hidden"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SidebarSel}"/>
              <Setter Property="Foreground" Value="{DynamicResource SidebarSelFg}"/>
            </Trigger>
            <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoft}"/>
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <HierarchicalDataTemplate x:Key="FolderTpl" ItemsSource="{Binding Children}">
    <DockPanel>
      <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" Opacity="0.6" Margin="8,0,0,0" VerticalAlignment="Center"/>
      <TextBlock Text="{Binding Glyph}" FontFamily="{DynamicResource IconFont}" Foreground="{DynamicResource TreeIconFg}" FontSize="13" Margin="0,0,5,0" VerticalAlignment="Center"/>
      <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
    </DockPanel>
  </HierarchicalDataTemplate>

  <!-- ======================= gallery (large icons view) ======================= -->
  <Style x:Key="GalleryItem" TargetType="ListBoxItem">
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Grid Width="{DynamicResource CardW}" Margin="8,6,8,8" Background="Transparent">
            <StackPanel>
              <Grid Height="{DynamicResource CardH}">
                <ContentControl x:Name="Frame" Style="{StaticResource BevelSunken}" Background="{DynamicResource ThumbBg}">
                  <Grid>
                    <TextBlock Text="{Binding Glyph}" FontFamily="{DynamicResource IconFont}" FontSize="24" Foreground="{DynamicResource Fg3}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding ShowGlyph, Converter={StaticResource B2V}}"/>
                    <Border Visibility="{Binding HasThumb, Converter={StaticResource B2V}}">
                      <Border.Background>
                        <ImageBrush ImageSource="{Binding Thumb}" Stretch="UniformToFill"/>
                      </Border.Background>
                    </Border>
                    <Image Source="{DynamicResource FolderArt}" Margin="16,8" Visibility="{Binding IsFolder, Converter={StaticResource B2V}}"/>
                    <Border VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="4" Background="{DynamicResource TipBg}" BorderBrush="{DynamicResource BevelDark}" BorderThickness="1" Padding="3,0,3,1" Visibility="{Binding HasBadge, Converter={StaticResource B2V}}">
                      <TextBlock Text="{Binding Badge}" Foreground="{DynamicResource TipFg}"/>
                    </Border>
                    <Border VerticalAlignment="Top" HorizontalAlignment="Right" Margin="4" Background="{DynamicResource Accent}" Padding="4,0,5,1" Visibility="{Binding IsActive, Converter={StaticResource B2V}}">
                      <TextBlock Text="► Actif" Foreground="{DynamicResource SelFg}" FontWeight="Bold"/>
                    </Border>
                  </Grid>
                </ContentControl>
                <Border x:Name="SelTint" Margin="2" Background="{DynamicResource AccentSoft}" Visibility="Collapsed"/>
              </Grid>
              <Border x:Name="NameBg" HorizontalAlignment="Center" Padding="3,0,3,1" Margin="0,5,0,0" BorderThickness="1" BorderBrush="Transparent">
                <TextBlock x:Name="NameText" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
              </Border>
              <TextBlock Text="{Binding Sub}" HorizontalAlignment="Center" Foreground="{DynamicResource Fg3}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
          </Grid>
          <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding IsFolder}" Value="True">
              <Setter TargetName="Frame" Property="Style" Value="{StaticResource BevelFlat}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
              <Setter TargetName="SelTint" Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="SelTint" Property="Visibility" Value="Visible"/>
              <Setter TargetName="NameBg" Property="Background" Value="{DynamicResource Accent}"/>
              <Setter TargetName="NameBg" Property="BorderBrush" Value="{DynamicResource Fg3}"/>
              <Setter TargetName="NameText" Property="Foreground" Value="{DynamicResource SelFg}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Gallery" TargetType="ListBox">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="SelectionMode" Value="Extended"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="ItemContainerStyle" Value="{StaticResource GalleryItem}"/>
    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate>
          <WrapPanel/>
        </ItemsPanelTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBox">
          <ContentControl Style="{StaticResource BevelSunken}" Background="{DynamicResource ListBg}" Margin="6,6,6,6">
            <ScrollViewer Focusable="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="6,6,6,12">
              <ItemsPresenter/>
            </ScrollViewer>
          </ContentControl>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="PlainItem" TargetType="ListBoxItem">
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Bd" Padding="4,0" Height="20" Background="Transparent">
            <ContentPresenter VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Accent}"/>
              <Setter Property="Foreground" Value="{DynamicResource SelFg}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="PlainList" TargetType="ListBox">
    <Setter Property="ItemContainerStyle" Value="{StaticResource PlainItem}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBox">
          <ContentControl Style="{StaticResource BevelSunken}" Background="{DynamicResource ListBg}">
            <ScrollViewer Focusable="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="2">
              <ItemsPresenter/>
            </ScrollViewer>
          </ContentControl>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <DataTemplate x:Key="MoveItemTpl">
    <StackPanel Orientation="Horizontal" Margin="{Binding IndentMargin}">
      <TextBlock Text="{Binding Glyph}" FontFamily="{DynamicResource IconFont}" Foreground="{DynamicResource TreeIconFg}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
      <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
    </StackPanel>
  </DataTemplate>

  <!-- ======================= menus / tooltip ======================= -->
  <Style TargetType="ContextMenu">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
    <Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
    <Setter Property="FontSize" Value="{DynamicResource UiFontSize}"/>
    <Setter Property="TextOptions.TextRenderingMode" Value="Aliased"/>
    <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContextMenu">
          <ContentControl Style="{StaticResource BevelWindow}" Padding="1">
            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
          </ContentControl>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="MenuItem">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <Border x:Name="Bd" Padding="4,3,20,3" Background="Transparent" MinWidth="190">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="22"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <ContentPresenter ContentSource="Icon" VerticalAlignment="Center" TextElement.FontFamily="{DynamicResource IconFont}" TextElement.FontSize="12"/>
              <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="False" VerticalAlignment="Center"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MenuHighlight}"/>
              <Setter Property="Foreground" Value="{DynamicResource MenuHighlightFg}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource Fg3}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Separator">
          <Border Height="2" Margin="2,3" Background="{DynamicResource EtchedH}"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ToolTip">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="HasDropShadow" Value="False"/>
    <Setter Property="TextOptions.TextRenderingMode" Value="Aliased"/>
    <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Background="{DynamicResource TipBg}" BorderBrush="{DynamicResource BevelDark}" BorderThickness="1" Padding="4,1,4,2">
            <ContentPresenter TextElement.Foreground="{DynamicResource TipFg}" TextElement.FontFamily="{DynamicResource UiFont}" TextElement.FontSize="{DynamicResource UiFontSize}"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
